# OpenClaw Bootstrap Configuration Template
# Copy this to .env and fill in the values to skip interactive prompts in oc-bootstrap.sh

# Inference Backend
LOCAL_INFERENCE=false # set to true if using Lemonade
LEMONADE_KEY=local-dummy-key
LEMONADE_IP=127.0.0.1

# Models
EMBEDDING_MODEL=openai/text-embedding-3-small
ASSISTANT_MODEL=openai/gpt-4o
RESEARCH_MODEL=openai/gpt-4o
DEVELOPER_MODEL=anthropic/claude-3-5-sonnet-latest

# Telegram Bot Tokens (Required)
ASSISTANT_TOKEN=
RESEARCH_TOKEN=
DEVELOPER_TOKEN=

# Optional Secrets
GITLAB_PAT=
BRAVE_API_KEY=
X_API_KEY=
