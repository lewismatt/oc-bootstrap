# ==============================================================================
# OpenClaw Multi-Agent Secrets Template
# 
# Instructions:
# 1. Copy this file to: ~/.openclaw/secrets.env
# 2. Populate the empty variables with your actual keys and tokens.
# 3. Ensure permissions are restricted: chmod 600 ~/.openclaw/secrets.env
# ==============================================================================

# Infrastructure Credentials
# Leave as 'local-dummy-key' if no authentication is required on your Lemonade server
LEMONADE_KEY=local-dummy-key

# Telegram Bot Tokens (Create these via @BotFather in Telegram)
ASSISTANT_TOKEN=
RESEARCH_TOKEN=
DEVELOPER_TOKEN=

# External Integrations (Optional)
# Composio API Key is required for Git repository read/write access
COMPOSIO_KEY=

# Brave API Key is required for the Research agent's webSearch skill
BRAVE_API_KEY=
