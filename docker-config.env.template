# ==============================================================================
# OpenClaw Docker Configuration Template
# ==============================================================================
# Copy this file to docker-config.env and fill in your values
# Then run: docker compose up -d
#
# WARNING: Never commit docker-config.env to version control!
# ==============================================================================

# --------------------------------------------------------------------------
# OpenClaw Configuration
# --------------------------------------------------------------------------

# Run bootstrap script on container start (true/false)
RUN_BOOTSTRAP=false

# Config file path (if using non-interactive mode with config)
# CONFIG_FILE=/home/openclaw/oc-bootstrap/.env

# --------------------------------------------------------------------------
# Storage Configuration
# --------------------------------------------------------------------------

# OpenClaw Volume Configuration
# Set OPENCLAW_VOLUME to choose storage type:
#
# Option 1: Named Volume (Recommended for production)
#   OPENCLAW_VOLUME=openclaw-data:/home/openclaw/.openclaw
#   - Docker manages the volume
#   - Easier backups, portable across OS (Linux/Windows/macOS)
#   - Harder to access files directly from host
#
# Option 2: Bind Mount (Easier file access from host)
#   Linux example: OPENCLAW_VOLUME=/home/youruser/.openclaw:/home/openclaw/.openclaw
#   macOS example: OPENCLAW_VOLUME=/Users/youruser/.openclaw:/home/openclaw/.openclaw
#   Windows example: OPENCLAW_VOLUME=/c/Users/YourUsername/.openclaw:/home/openclaw/.openclaw
#   - Note: Ensure host directory exists BEFORE starting container
#   - Linux/macOS: sudo chown -R 1000:1000 /path/to/.openclaw
#   - Windows: Docker Desktop handles permissions automatically
#
OPENCLAW_VOLUME=openclaw-data:/home/openclaw/.openclaw

# --------------------------------------------------------------------------
# Inference Backend Selection
# --------------------------------------------------------------------------

# Use local inference via Lemonade Server (true/false)
# If true, set LEMONADE_KEY and configure Lemonade Server
LOCAL_INFERENCE=false

# Lemonade Server API Key (use 'local-dummy-key' if not needed)
LEMONADE_KEY=local-dummy-key

# Lemonade Server IP address (if running separately)
# LEMONADE_IP=192.168.12.50

# --------------------------------------------------------------------------
# Model Selection
# --------------------------------------------------------------------------

# Embedding model for memory/vector search
# Examples: openai/text-embedding-3-small, lemonade/user.Qwen3.5-4B-GGUF
EMBEDDING_MODEL=openai/text-embedding-3-small

# Assistant Agent LLM
# Examples: openai/gpt-4o, anthropic/claude-3-5-sonnet-latest
ASSISTANT_MODEL=openai/gpt-4o

# Research Agent LLM
RESEARCH_MODEL=openai/gpt-4o

# Developer Agent LLM
DEVELOPER_MODEL=anthropic/claude-3-5-sonnet-latest

# --------------------------------------------------------------------------
# Telegram Bot Tokens (REQUIRED)
# --------------------------------------------------------------------------
# Get these from @BotFather on Telegram
# Each agent needs a unique token

ASSISTANT_TOKEN=your_assistant_bot_token_here
RESEARCH_TOKEN=your_research_bot_token_here
DEVELOPER_TOKEN=your_developer_bot_token_here

# --------------------------------------------------------------------------
# Optional: External API Keys
# --------------------------------------------------------------------------

# GitHub Personal Access Token (for GitHub MCP server)
GITHUB_PAT=

# GitLab Personal Access Token (for GitLab MCP server)
GITLAB_PAT=

# Brave Search API Key (for Research Agent web search)
BRAVE_API_KEY=

# X/Twitter API Key or Auth Cookie (for xScraper)
X_API_KEY=

# --------------------------------------------------------------------------
# Advanced Configuration
# --------------------------------------------------------------------------

# Telegram API Server URL (leave default unless using custom server)
# TELEGRAM_API_SERVER=https://api.telegram.org

# OpenClaw Gateway Port
# OPENCLAW_PORT=3000

# Log Level (debug, info, warn, error)
# LOG_LEVEL=info
