# OpenClaw Docker Configuration Template
# Copy to docker-config.env and customize for your environment

# =============================================================================
# CORE SETTINGS
# =============================================================================

# OpenClaw Home Directory (inside container)
OPENCLAW_HOME=/opt/openclaw

# User to run OpenClaw services (default: openclaw for security)
OPENCLAW_USER=openclaw

# Environment mode: development, staging, production
OPENCLAW_ENV=development

# =============================================================================
# GITLAB INTEGRATION
# =============================================================================

# GitLab API Token (requires api, read_repository, write_repository scopes)
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# GitLab Instance URL (default: https://gitlab.com)
# GITLAB_URL=https://gitlab.com

# GitLab Project ID or path (e.g., username/project-name)
# GITLAB_PROJECT_ID=12345678
# GITLAB_PROJECT_PATH=username/project-name

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================

# Default model for agents (e.g., llama3.2, granite3.2, mistral)
# See https://ollama.com/library for available models
OPENCLAW_DEFAULT_MODEL=llama3.2

# Number of parallel agents to run
OPENCLAW_AGENT_COUNT=3

# Agent memory backend: file, redis, postgres
OPENCLAW_MEMORY_BACKEND=file

# =============================================================================
# LEMONADE SERVER
# =============================================================================

# Lemonade Server URL (for model serving)
# LEMONADE_URL=http://lemonade-server:8080

# Lemonade API Key (if authentication is enabled)
# LEMONADE_API_KEY=your-api-key

# =============================================================================
# DOCKER SETTINGS
# =============================================================================

# Docker network name
OPENCLAW_DOCKER_NETWORK=openclaw-network

# Container name prefix
OPENCLAW_CONTAINER_PREFIX=openclaw

# Volume mount path for persistence
OPENCLAW_VOLUME_PATH=/var/lib/openclaw

# =============================================================================
# LOGGING
# =============================================================================

# Log level: debug, info, warn, error
OPENCLAW_LOG_LEVEL=info

# Log file path (leave empty for stdout)
OPENCLAW_LOG_FILE=/var/log/openclaw/openclaw.log

# =============================================================================
# SECURITY
# =============================================================================

# Enable SSL/TLS
OPENCLAW_SSL_ENABLED=false

# Path to SSL certificate
# OPENCLAW_SSL_CERT=/etc/openclaw/ssl/cert.pem

# Path to SSL key
# OPENCLAW_SSL_KEY=/etc/openclaw/ssl/key.pem

# CORS allowed origins (comma-separated)
OPENCLAW_CORS_ORIGINS=*
