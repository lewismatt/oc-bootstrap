# OpenClaw Test Configuration Template
# Copy to test-config.env and customize for your test environment

# =============================================================================
# TEST SETTINGS
# =============================================================================

# Test mode: unit, integration, docker, all
TEST_MODE=all

# Verbose output
TEST_VERBOSE=true

# Test timeout (seconds)
TEST_TIMEOUT=300

# =============================================================================
# DOCKER SETTINGS
# =============================================================================

# Docker image name for testing
TEST_DOCKER_IMAGE=openclaw-test

# Docker container name
TEST_CONTAINER_NAME=openclaw-test

# Docker network for tests
TEST_DOCKER_NETWORK=openclaw-test-network

# =============================================================================
# OPENCLAW SETTINGS
# =============================================================================

# OpenClaw test directory
OPENCLAW_HOME=/tmp/openclaw-test

# Test model (smaller model for faster tests)
TEST_MODEL=llama3.2:1b

# Number of agents for testing
TEST_AGENT_COUNT=1

# =============================================================================
# LEMONADE SETTINGS
# =============================================================================

# Lemonade test port
LEMONADE_TEST_PORT=8081

# =============================================================================
# LOGGING
# =============================================================================

# Log level for tests
TEST_LOG_LEVEL=debug

# Log file path
TEST_LOG_FILE=/tmp/openclaw-test.log
